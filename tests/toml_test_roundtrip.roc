round_trip : Str -> Bool
round_trip = |text|
	match Toml.parse(text) {
		Ok(doc) =>
			match Toml.parse(Toml.print(doc.table())) {
				Ok(again) => again.table() == doc.table()
				Err(_) => Bool.False
			}

		Err(_) => Bool.False
	}

